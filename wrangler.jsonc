{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hushbook",
  "main": "src/worker.mjs",
  // Newest date the runtime bundled with wrangler 4.94 supports, so local dev matches production.
  "compatibility_date": "2026-05-21",
  // No public staging host: hushbook.app is the only hostname Google should ever see.
  "workers_dev": false,
  "preview_urls": false,
  // Cutover (docs/migration/cloudflare-workers.md):
  // Production: this route captures hushbook.app before it reaches Vercel. Remove it to roll back.
  "routes": [{ "pattern": "hushbook.app/*", "zone_name": "hushbook.app" }],
  "observability": { "enabled": true },
  // Installer download log, written by /dl/<platform> (src/downloads.mjs). Read it with `npm run stats:downloads`.
  "d1_databases": [
    { "binding": "DB", "database_name": "hushbook-downloads", "database_id": "ae00f9b4-cfd5-463b-961c-d643f3f441f8", "migrations_dir": "migrations" }
  ],
  "assets": {
    // The repo root is the site; .assetsignore keeps source, tooling and secrets out.
    "directory": "./",
    "binding": "ASSETS",
    // Clean URLs: /about serves about.html; /about.html and /about/ redirect to /about.
    "html_handling": "drop-trailing-slash",
    // Paths with no asset get the nearest 404.html with status 404.
    "not_found_handling": "404-page",
    // The Worker runs only here: / (locale redirects), /*=* (/utm_source=x links) and /dl/* (download log). Every other path, 404s included, never reaches it.
    "run_worker_first": ["/", "/*=*", "/dl/*", "!/assets/*"]
  }
}
